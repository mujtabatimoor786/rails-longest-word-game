<div class="container mt-5">
  <h1 class="mb-4">New game</h1>

  <ul class="letters list-unstyled d-flex gap-2 mb-4">
    <% @letters.each do |letter| %>
      <li class="letter-tile"><%= letter %></li>
    <% end %>
  </ul>

  <p class="form-prefix">What is the longest word you can find?</p>

  <form action="/score" method="post" data-turbo="false" class="input-group w-50">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <%= hidden_field_tag :letters, @letters %>
    <input type="text" name="word" class="form-control" placeholder="Type your word..." required>
    <input type="submit" value="Play" class="btn btn-outline-secondary">
  </form>
</div>
